{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotaireDZ",
  "version": "1.0.1",
  "identifier": "dz.notaire.office",
  "build": {
    "beforeDevCommand": "npm --prefix ../../app run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../../app run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "NotaireDZ",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
